# FCR Python repository ignore rules
# The existing SQLite baseline database is tracked intentionally for app/test compatibility.
# Machine-local settings and secrets are not tracked.

# Python bytecode and packaging metadata
__pycache__/
*.py[cod]
*$py.class
*.egg-info/

# Virtual environments
.venv/
venv/
env/
ENV/

# Local secrets / machine-specific settings
.env
.env.*
settings.json

# PyInstaller and archive build output
build/
dist/
*.exe
*.zip
FCR_Dashboard.zip

# Runtime output
logs/
backups/
exports/
*.log

# Test, coverage and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Editors and OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
